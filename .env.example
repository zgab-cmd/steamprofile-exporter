# Copy this file to .env and fill in your credentials. Vanity id-s are supported, but you must use your own Steam API key. You can get one here: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=YOUR_API_KEY_HERE
STEAM_ID=YOUR_STEAM_ID_HERE
# Optional: address to listen on. Default is :9805
LISTEN_ADDR=:9805
